---
// src/components/Layout.astro
import "@fontsource/noto-serif-thai/600.css";
import "@fontsource/anuphan/400.css";
import "@fontsource/anuphan/600.css";
import "@fontsource/anuphan/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/tokens.css";

interface Props {
  lang: "en" | "th";
  title: string;
  // Show a "← Back to recipes" link in embed mode. Only pages reached BY
  // clicking through from the browse index (recipe detail, tag pages) should
  // pass this — the index itself is the entry point, nothing to go back to.
  showEmbedBack?: boolean;
}
const { lang, title, showEmbedBack = false } = Astro.props;

const comingSoonTitle = lang === "th" ? "เร็วๆ นี้" : "Coming soon";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Thai Macros</title>
    <script is:inline>
      // Iframe-embed mode (FitPang-Bot's community.html Cookbook tab loads this site
      // with ?embed=1). This site builds fully static (output: "static") — there's
      // no server at request time to read a query string, so the flag has to be
      // detected client-side. Runs synchronously, before <body> renders, so the nav
      // never flashes before CSS hides it (same pattern as dark-mode-detection
      // inline scripts).
      if (new URLSearchParams(location.search).get("embed") === "1") {
        document.documentElement.classList.add("embed");
      }
      // Propagate embed mode through internal navigation. Recipe cards
      // (client-rendered on the index page) and tag-page links are built
      // without any knowledge of embed mode, so without this, clicking from
      // the embedded browse grid into a recipe drops the flag — the full
      // site-nav header (with links that go nowhere useful inside the
      // iframe) reappears, which is also wider than the iframe and causes
      // horizontal scroll. Event delegation on document, not a one-time DOM
      // scan, because some of those links don't exist yet when this script
      // runs (added later by the index page's own script).
      document.addEventListener("click", (event) => {
        if (!document.documentElement.classList.contains("embed")) return;
        const link = event.target && event.target.closest && event.target.closest("a[href]");
        if (!link) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        if (url.searchParams.get("embed") === "1") return;
        event.preventDefault();
        url.searchParams.set("embed", "1");
        location.href = url.toString();
      });
    </script>
  </head>
  <body>
    <nav class="site-nav">
      <a class="wordmark" href={`/${lang}/`}>
        Thai<span class="accent-dot">·</span>Macros
      </a>
      <div class="nav-links">
        <a href={`/${lang}/`}>{lang === "th" ? "สูตรอาหาร" : "Recipes"}</a>
        <button type="button" class="nav-placeholder" disabled title={comingSoonTitle}>
          {lang === "th" ? "คำนวณแคล" : "Calorie calculator"}
        </button>
        <button type="button" class="nav-placeholder" disabled title={comingSoonTitle}>
          {lang === "th" ? "แผนมื้ออาหาร" : "Meal plan"}
        </button>
      </div>
      <div class="lang-toggle">
        <a href="/en/" aria-current={lang === "en" ? "page" : undefined}>EN</a>
        <a href="/th/" aria-current={lang === "th" ? "page" : undefined}>TH</a>
      </div>
    </nav>
    <main class="page">
      {showEmbedBack && (
        <a class="embed-back" href={`/${lang}/?embed=1`}>
          ← {lang === "th" ? "กลับไปที่สูตรอาหาร" : "Back to recipes"}
        </a>
      )}
      <slot />
    </main>
  </body>
</html>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 18px 28px;
    border-bottom: 1px solid var(--line);
  }
  .wordmark {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 19px;
    text-decoration: none;
    color: var(--fg);
  }
  .wordmark .accent-dot {
    color: var(--green-hi);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1;
    font-size: 13.5px;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--fg-dim);
  }
  .nav-placeholder {
    background: none;
    border: none;
    color: var(--fg-faint);
    font-family: var(--sans);
    font-size: 13.5px;
    cursor: not-allowed;
    padding: 0;
  }
  .lang-toggle {
    display: flex;
    gap: 2px;
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 3px;
  }
  .lang-toggle a {
    text-decoration: none;
    color: var(--fg-dim);
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    display: inline-block;
  }
  .lang-toggle a[aria-current="page"] {
    background: var(--green);
    color: var(--bg-0);
  }
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px 28px 80px;
  }
  :global(html.embed) .site-nav {
    display: none;
  }
  :global(html.embed) .page {
    padding: 14px 14px 40px;
  }
  .embed-back {
    display: none;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-dim);
    text-decoration: none;
    margin-bottom: 14px;
  }
  :global(html.embed) .embed-back {
    display: inline-flex;
  }
</style>
